<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.zms.gohostdeliveryservice</groupId>
    <artifactId>gohostdelivery-service-app</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>gohostdelivery-service-app-boot</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <description>Boot module - Spring Boot entry point</description>

  <dependencies>
    <dependency>
      <groupId>com.zms.gohostdeliveryservice</groupId>
      <artifactId>gohostdelivery-service-app-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zms.gohostdeliveryservice</groupId>
      <artifactId>gohostdelivery-service-app-application</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zms.gohostdeliveryservice</groupId>
      <artifactId>gohostdelivery-service-app-infrastructure</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zms.gohostdeliveryservice</groupId>
      <artifactId>gohostdelivery-service-app-rest</artifactId>
    </dependency>
    <!-- Google Cloud SQL Socket Factory: conexión segura a Cloud SQL sin SSL externo -->
    <dependency>
      <groupId>com.google.cloud.sql</groupId>
      <artifactId>postgres-socket-factory</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
